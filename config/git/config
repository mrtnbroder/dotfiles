# vim: ft=gitconfig

[user]
email = "mrtnbroder@gmail.com"
name = "Martin Broder"
signingKey = "~/.ssh/id_ed25519_github.pub"

[gpg]
format = "ssh"

[column]
ui = auto

[color]
ui = auto
interactive = auto

[credential]
helper = osxkeychain

[hub]
protocol = git

[merge]
ff = only

[diff]
tool = vimdiff
algorithm = histogram

[commit]
gpgsign = true
verbose = true
#	template = ~/.config/git.d/template

[branch]
# autosetuprebase = always
# autosetupmerge = always
sort = -committerdate

[push]
autoSetupRemote = true
default = upstream

[pull]
rebase = true
ff = only

[tag]
forceSignAnnotated = true
sort = -version:refname

[rerere]
enabled = true

[rebase]
updateRefs = true
autosquash = true

[core]
commitGraph = true
autocrlf = input
editor = $EDITOR
ignorecase = false
symlinks = true
compression = 9
editor = "nvim"

[fetch]
prune = true

[mergetool]
keepBackup = false

[init]
defaultBranch = main

[maintenance]
auto = true
strategy = incremental

[includeIf "gitdir:~/Developer/BDR/"]
path = ~/.config/git.d/config-bdr
